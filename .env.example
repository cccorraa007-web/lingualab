# ============================================================
# HablaYa 环境变量示例
# 复制本文件为 .env.local 并填入真实值：
#   cp .env.example .env.local
# 注意：.env.local 已被 .gitignore 忽略，切勿提交到仓库。
# ============================================================

# ---- Supabase（数据库）----
# 获取位置：Supabase 控制台 → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- DeepSeek（大模型：语料分析 / 对话 / 润色）----
# 获取位置：DeepSeek 开放平台 → API Keys
DEEPSEEK_API_KEY=

# ---- 阿里云（语音识别 ASR / 语音合成 TTS）----
# 建议使用 RAM 子账号的 AccessKey，不要用主账号密钥。
# 获取位置：阿里云 RAM 访问控制 → 子账号 AccessKey
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=

# 智能语音交互 NLS 项目的 AppKey（西语识别）。
# 获取位置：智能语音交互控制台 → 全部项目 → 项目功能配置
ALIYUN_APP_KEY=

# 英语语音识别的 NLS 项目 AppKey（可选，仅在「学英语」且需要语音识别时配置）。
# 需要一个英语模型的 NLS 项目；不填则英语识别复用西语项目（识别会不准）。
ALIYUN_APP_KEY_EN=

# 可选：TTS 发音人，默认 Camila（西班牙语女声）
ALIYUN_TTS_VOICE=Camila
